{
  "manifest_version": 2,
  "name": "IUC Shield",
  "version": "1.0.0",
  "description": "Native GeckoView Ad, Tracker, and Pop-up Blocking Engine",
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}

